rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email == "25011cseai0144@aiml.suh.edu.in";
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
  }
}
